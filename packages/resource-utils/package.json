{
  "name": "@dolthub/proto-resource-utils",
  "author": "DoltHub",
  "description": "Utilities for handling Google protobuf resources and names",
  "version": "0.2.3",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "web",
    "utils",
    "frontend"
  ],
  "scripts": {
    "compile": "tsc -b",
    "build": "rollup -c --bundleConfigAsCjs",
    "dbuild": "yarn compile && yarn build",
    "lint": "eslint --cache --ext .ts,.js,.tsx,.jsx src",
    "prettier": "prettier --check 'src/**/*.{js,ts}'",
    "prettier-fix": "prettier --write 'src/**/*.{js,ts}'",
    "npm:publish": "yarn dbuild && npm publish",
    "test": "jest",
    "yalc:publish": "yarn dbuild && yalc publish",
    "yalc:push": "yarn dbuild && yalc push"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/eslint": "^9",
    "@types/jest": "^30.0.0",
    "@types/rollup-plugin-peer-deps-external": "^2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.2",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rollup": "^4.64.10",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^7.0.2",
    "yalc": "^1.0.0-pre.53"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolthub/react-library.git"
  },
  "bugs": {
    "url": "https://github.com/dolthub/react-library/issues"
  }
}
